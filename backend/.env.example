# TaskFlow AI Backend Environment Configuration

PROJECT_NAME="TaskFlow AI"
SECRET_KEY="taskflow-super-secret-jwt-key-production-ready-2025"

# Database Configuration (SQLite is default: zero-config, embedded, works out of the box)
DATABASE_TYPE="sqlite"
SQLITE_PATH="taskflow.db"

# Optional: To use external MongoDB Atlas, set DATABASE_TYPE="mongodb" and supply MONGODB_URI:
# DATABASE_TYPE="mongodb"
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/taskflow_ai?retryWrites=true&w=majority"

# AI Provider Configuration (Optional - TaskFlow AI features intelligent heuristic engines when keys are omitted)
# Set GEMINI_API_KEY to activate Google Gemini 2.5 Flash
GEMINI_API_KEY=""
# Set GROQ_API_KEY to activate Groq Llama 3.3
GROQ_API_KEY=""
AI_PROVIDER="gemini"
